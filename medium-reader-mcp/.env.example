# Medium Authentication Cookies
#
# To get these values:
# 1. Go to medium.com in your browser (logged in)
# 2. Open DevTools (F12) → Application → Cookies → medium.com
# 3. Copy the values for 'sid' and 'uid'
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env

MEDIUM_SID=your-sid-value-here
MEDIUM_UID=your-uid-value-here
